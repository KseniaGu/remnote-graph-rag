# LOCAL DEVELOPMENT
# Runtime serving is load-only. Keep all *_INIT_FROM_LOCAL flags false.
# Enable the relevant flags only while running an intentional migration command.

# Redis (local Docker or cloud Upstash)
# For cloud: replace localhost with <redis-url>.upstash.io and fill REDIS_PASSWORD
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INIT_FROM_LOCAL=false
# Set overwrite to true when you need to update all embeddings (e.g. the embedder model has changed) in a Vector Store
REDIS_OVERWRITE_INDEX=false

# Pinecone (for vector storage in cloud)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=remnote-graph-rag
PINECONE_INIT_FROM_LOCAL=false

# Neo4j (local Docker or Neo4j Sandbox/Aura)
# For local: use HOST and PORT
# For cloud: use URI (takes precedence over HOST:PORT)
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_INIT_FROM_LOCAL=false

# Memgraph
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=app_user
MEMGRAPH_PASSWORD=1234
MEMGRAPH_DATABASE=memgraph
MEMGRAPH_INIT_FROM_LOCAL=false


# MongoDB (for LangGraph checkpointing)
# For local dev: use localhost with credentials created during VM/Docker setup
# For production: use the VM's internal IP
MONGODB_URI=mongodb://app_user:password@localhost:27017/langgraph_checkpoints?authSource=langgraph_checkpoints
MONGODB_DB_NAME=langgraph_checkpoints


# PRODUCTION (Cloud Run)

# Environment (DEV/PROD)
ENV=DEV

# Assets directory path
ASSET_BASE_URL=

# API Keys
OLLAMA_API_KEY=
TAVILY_API_KEY=
COHERE_API_KEY=

# Langsmith monitoring
# Set LANGSMITH_TRACING=true to activate tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Local retrieval models
EMBEDDER_MODEL_PATH=models/all-MiniLM-L6-v2
RERANKER_MODEL_PATH=models/Qwen3-Reranker-0.6B

CHAT_LIMITS_SHARED_QUOTAS_ENABLED=true
