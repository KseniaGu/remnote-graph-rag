{
  "name": "remnote-graph-rag",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/remnote-graph-rag",

  "runServices": [
    "redis",
    "memgraph",
    "mongodb"
  ],
  "shutdownAction": "stopCompose",

  "forwardPorts": [
    3000,
    8000,
    6379,
    7687,
    27017
   ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh"
}